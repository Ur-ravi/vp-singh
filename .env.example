CI_ENVIRONMENT = production

# ============================================================
# APPLICATION SETTINGS
# ============================================================
# On Hostinger, set your actual domain with trailing slash.
# IMPORTANT: Use https:// if SSL is enabled on your Hostinger hosting.
app.baseURL = 'https://yourdomain.com/'

# ============================================================
# DATABASE SETTINGS
# ============================================================
# On Hostinger:
#   1. Go to hPanel > Databases > MySQL Databases
#   2. Create a new database and user
#   3. Note the database name, username, and password
#   4. Import database.sql into your new database
database.default.hostname = localhost
database.default.database = uXXXXXX_yourdb
database.default.username = uXXXXXX_youruser
database.default.password = your_password
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# ============================================================
# EMAIL (SMTP) SETTINGS
# ============================================================
# On Hostinger, use their SMTP server:
#   Host: smtp.hostinger.com
#   Port: 465 (SSL) or 587 (TLS)
#   Username: your-email@yourdomain.com
#   Password: your email password
email.protocol = smtp
email.SMTPHost = smtp.hostinger.com
email.SMTPUser = info@yourdomain.com
email.SMTPPass = your_email_password
email.SMTPPort = 465
email.SMTPCrypto = ssl
email.fromEmail = info@yourdomain.com
email.fromName = V P Singh Advocate
